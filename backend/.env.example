# Backend configuration. Copy to `.env` (`cp .env.example .env`) and adjust.
# Never commit `.env`: it's git-ignored because it holds secrets.
# As copied, this file works for local development with `docker compose up -d`.

# ── Django ──────────────────────────────────────────────────────────────────
# Must be False in production.
DEBUG=True
# Any long random string; required when DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Hostnames this API answers to (comma-separated). On Render the service's own
# hostname is added automatically (RENDER_EXTERNAL_HOSTNAME).
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed for the Django admin behind a custom domain, e.g. https://api.example.com
# CSRF_TRUSTED_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml. On Neon, use the pooled string (host ends in -pooler).
DATABASE_URL=postgres://booking:booking@localhost:5433/booking
# Direct (non-pooled) connection, used only for migrations and seeding (backend/build.sh).
# Leave unset locally; build.sh falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# ── Frontend ────────────────────────────────────────────────────────────────
# The web app's address: the only site allowed to call this API (comma-separated, no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Where checkout and emails send people back to.
FRONTEND_URL=http://localhost:5173

# ── Business ────────────────────────────────────────────────────────────────
# Working hours are read in this time zone; everything is stored in UTC.
BUSINESS_TIMEZONE=America/New_York
# BUSINESS_NAME=Studio Booking

# ── Demo ────────────────────────────────────────────────────────────────────
# One-click demo logins (/demo/customer, /demo/staff, /demo/owner) and demo guardrails.
# Set to False for a real business.
DEMO_MODE=True

# ── Payments ────────────────────────────────────────────────────────────────
# stripe | demo | none. Unset: Stripe if STRIPE_SECRET_KEY is set, else demo (in DEMO_MODE), else none.
# PAYMENT_PROVIDER=
# PAYMENT_CURRENCY=usd
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (reminders) ───────────────────────────────────────────────────────
# Without EMAIL_HOST, emails are printed to the console/log instead of sent.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Studio Booking <bookings@example.com>
